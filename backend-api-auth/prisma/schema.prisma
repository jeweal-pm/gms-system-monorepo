generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth"]
}

model User {
  id               String         @id
  name             String
  /// ADR-0020: login identity; trimmed, lowercased, 3..64 of [a-z0-9._@+-], immutable.
  username         String         @unique @db.VarChar(64)
  /// ADR-0020: internal `<id>@users.invalid`, never shown or editable.
  email            String         @unique
  emailVerified    Boolean        @default(false)
  image            String?
  role             String         @default("user")
  failedLoginCount Int            @default(0) @map("failed_login_count")
  lockedUntil      DateTime?      @map("locked_until")
  lastLoginAt      DateTime?      @map("last_login_at")
  createdAt        DateTime
  updatedAt        DateTime
  sessions         Session[]
  accounts         Account[]
  loginAttempts    LoginAttempt[]
  licenseCache     LicenseCache?
  licenseCurrentDecision LicenseCurrentDecision?
  licenseActivationLockout LicenseActivationLockout?
  active           Boolean          @default(true)
  phoneE164        String?          @map("phone_e164") @db.VarChar(16)
  phoneCountry     String?          @map("phone_country") @db.Char(2)
  permissions      UserPermission[]
  locations        UserLocation[]
  photo            UserPhoto?
  refreshFamilies  RefreshFamily[]

  @@index([role, createdAt])
  @@schema("auth")
}

enum PermissionAction {
  VIEW
  ADD
  EDIT
  DELETE
  CANCEL
  APPROVE
  PRICE
  PRINT
  EXCEL

  @@schema("auth")
}

model UserPermission {
  userId    String           @map("user_id")
  menuKey   String           @map("menu_key") @db.VarChar(64)
  action    PermissionAction
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, menuKey, action])
  @@schema("auth")
}

model UserLocation {
  userId      String @map("user_id")
  locationKey String @map("location_key") @db.VarChar(64)
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, locationKey])
  @@schema("auth")
}

model UserPhoto {
  userId      String   @id @map("user_id")
  contentType String   @map("content_type") @db.VarChar(16)
  sizeBytes   Int      @map("size_bytes")
  sha256      String   @db.Char(64)
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("auth")
}

model LoginAttempt {
  id          String   @id
  userId      String?  @map("user_id")
  emailHash   String   @map("email_hash")
  success     Boolean
  attemptedAt DateTime @default(now()) @map("attempted_at")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, attemptedAt])
  @@index([emailHash, attemptedAt])
  @@schema("auth")
}

model LoginLockout {
  emailHash        String    @id @map("email_hash")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")

  @@schema("auth")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshFamilies RefreshFamily[]

  @@index([userId])
  @@schema("auth")
}

/// Additive GMS refresh state. Existing Better Auth sessions remain authoritative.
model RefreshFamily {
  id          String    @id @db.Uuid
  userId      String    @map("user_id")
  sessionId   String    @map("session_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  credentials RefreshCredential[]

  @@index([userId, revokedAt])
  @@index([sessionId])
  @@schema("auth")
}

model RefreshCredential {
  id         String    @id @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  family     RefreshFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, consumedAt])
  @@schema("auth")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@schema("auth")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@schema("auth")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@schema("auth")
}

model LicenseCache {
  userId      String    @id @map("user_id")
  token       String    @db.Text
  fetchedAt   DateTime  @default(now()) @map("fetched_at")
  lastErrorAt DateTime? @map("last_error_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("auth")
}

/// Staged GMS v2 decision cache. Legacy LicenseCache remains untouched for route rollback.
model LicenseCurrentDecision {
  userId         String   @id @map("user_id")
  lastCheckOrder BigInt   @map("last_check_order")
  state          String   @db.VarChar(8)
  signedToken    String?  @map("signed_token") @db.Text
  successfulAt   DateTime? @map("successful_at") @db.Timestamptz(6)
  decidedAt      DateTime @map("decided_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("auth")
}

model LicenseActivationLockout {
  userId         String    @id @map("user_id")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("auth")
}
