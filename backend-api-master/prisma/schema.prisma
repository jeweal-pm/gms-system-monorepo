  shippingAddress         CustomerAddress?   @relation("MemoOutShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  invoiceAddress          CustomerAddress?   @relation("MemoOutInvoiceAddress", fields: [invoiceAddressId], references: [id], onDelete: SetNull)
