model MemoReceiveCharge {
  memoReceiveId String      @map("memo_receive_id") @db.Uuid
  chargeType    String      @map("charge_type") @db.VarChar(20)
  amount        Decimal     @db.Decimal(18, 2)
  document      MemoReceive @relation(fields: [memoReceiveId], references: [id], onDelete: Cascade)

  @@id([memoReceiveId, chargeType])
  @@map("memo_receive_charge")
  @@schema("partner")
}

/// Memo Return (memo-return SA revision 1, owner 2026-10-29): stones sent back to the vendor they were received from
/// on memo. Lines come from the vendor's Memo Receive lines (Memo Stock); only the Return quantity is keyed in.
model MemoReturn {
  id                 String             @id @db.Uuid
  numberingId        String?            @map("numbering_id") @db.Uuid
  runningNo          Int                @map("running_no")
  docNo              String             @unique(map: "memo_return_doc_no_key") @map("doc_no") @db.VarChar(40)
  status             String             @db.VarChar(20)
  docDate            DateTime           @map("doc_date") @db.Date
  dueDate            DateTime           @map("due_date") @db.Date
  vendorId           String             @map("vendor_id") @db.Uuid
  vendorCodeSnapshot String             @map("vendor_code_snapshot") @db.VarChar(120)
  vendorNameSnapshot String             @map("vendor_name_snapshot") @db.VarChar(200)
  addressId          String?            @map("address_id") @db.Uuid
  addressSnapshot    String             @map("address_snapshot") @db.VarChar(1000)
  currencyCode       String             @map("currency_code") @db.Char(3)
  exchangeRate       Decimal?           @map("exchange_rate") @db.Decimal(18, 6)
  ref                String             @default("") @db.VarChar(100)
  documentNote       String             @default("") @map("document_note") @db.VarChar(500)
  discountType       String             @map("discount_type") @db.VarChar(10)
  discountValue      Decimal            @map("discount_value") @db.Decimal(18, 4)
  taxEnabled         Boolean            @map("tax_enabled")
  taxRate            Decimal            @map("tax_rate") @db.Decimal(9, 4)
  taxIncluded        Boolean            @map("tax_included")
  laborWork          String?            @map("labor_work") @db.VarChar(120)
  laborBasis         String?            @map("labor_basis") @db.VarChar(10)
  laborQty           Decimal?           @map("labor_qty") @db.Decimal(18, 3)
  laborRate          Decimal?           @map("labor_rate") @db.Decimal(18, 2)
  subtotal           Decimal            @db.Decimal(18, 2)
  discountAmount     Decimal            @map("discount_amount") @db.Decimal(18, 2)
  priceBeforeTax     Decimal            @map("price_before_tax") @db.Decimal(18, 2)
  taxAmount          Decimal            @map("tax_amount") @db.Decimal(18, 2)
  chargesAmount      Decimal            @map("charges_amount") @db.Decimal(18, 2)
  laborAmount        Decimal            @map("labor_amount") @db.Decimal(18, 2)
  grandTotal         Decimal            @map("grand_total") @db.Decimal(18, 2)
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamp(3)
  createdBy          String             @map("created_by") @db.VarChar(64)
  updatedAt          DateTime           @default(now()) @map("updated_at") @db.Timestamp(3)
  updatedBy          String             @map("updated_by") @db.VarChar(64)
  numbering          DocumentNumbering? @relation(fields: [numberingId], references: [id], onDelete: Restrict)
  vendor             Vendor             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  address            VendorAddress?     @relation(fields: [addressId], references: [id], onDelete: SetNull)
  lines              MemoReturnLine[]
  charges            MemoReturnCharge[]

  @@unique([numberingId, runningNo], map: "memo_return_numbering_running_no_key")
  @@unique([runningNo], where: { numberingId: null }, map: "memo_return_plain_running_no_key")
  @@index([docDate(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "memo_return_list_idx")
  @@index([vendorId, docDate(sort: Desc)], map: "memo_return_vendor_idx")
  @@index([addressId], map: "memo_return_address_idx")
  @@map("memo_return")
  @@schema("partner")
}

model MemoReturnLine {
  id                  String          @id @db.Uuid
  memoReturnId        String          @map("memo_return_id") @db.Uuid
  position            Int             @db.SmallInt
  /// Quantity still out when the line was picked; pcs / weightCt are what comes back now (≤ outstanding).
  outstandingPcs      Int             @default(0) @map("outstanding_pcs")
  outstandingWeightCt Decimal         @default(0) @map("outstanding_weight_ct") @db.Decimal(12, 3)
  /// The Memo Receive line this return comes from (Memo Stock); item fields and price are copied from it on save.
  sourceLineId        String          @map("source_line_id") @db.Uuid
  source              String          @db.VarChar(10)
  stoneCodeId         String?         @map("stone_code_id") @db.Uuid
  stoneCodeSnapshot   String          @default("") @map("stone_code_snapshot") @db.VarChar(60)
  stone               String          @default("") @db.VarChar(60)
  shape               String          @default("") @db.VarChar(60)
  size                String          @default("") @db.VarChar(60)
  color               String          @default("") @db.VarChar(60)
  clarity             String          @default("") @db.VarChar(60)
  cutting             String          @default("") @db.VarChar(60)
  quality             String          @default("") @db.VarChar(60)
  lot                 String          @default("") @db.VarChar(40)
  location            String          @default("") @db.VarChar(40)
  cerType             String          @default("") @map("cer_type") @db.VarChar(20)
  cerNo               String          @default("") @map("cer_no") @db.VarChar(60)
  pcs                 Int
  weightCt            Decimal         @map("weight_ct") @db.Decimal(12, 3)
  priceUnit           String          @map("price_unit") @db.VarChar(10)
  unitPrice           Decimal         @map("unit_price") @db.Decimal(18, 2)
  discountType        String          @default("NONE") @map("discount_type") @db.VarChar(10)
  discountValue       Decimal         @default(0) @map("discount_value") @db.Decimal(18, 4)
  discountAmount      Decimal         @default(0) @map("discount_amount") @db.Decimal(18, 2)
  amount              Decimal         @db.Decimal(18, 2)
  itemNote            String          @default("") @map("item_note") @db.VarChar(500)
  document            MemoReturn      @relation(fields: [memoReturnId], references: [id], onDelete: Cascade)
  stoneCode           StoneCode?      @relation(fields: [stoneCodeId], references: [id], onDelete: SetNull)
  sourceLine          MemoReceiveLine @relation(fields: [sourceLineId], references: [id], onDelete: Restrict)

  @@unique([memoReturnId, position], map: "memo_return_line_position_key")
  @@index([stoneCodeId], map: "memo_return_line_stone_code_idx")
  @@index([sourceLineId], map: "memo_return_line_source_line_idx")
  @@map("memo_return_line")
  @@schema("partner")
}

model MemoReturnCharge {
  memoReturnId String     @map("memo_return_id") @db.Uuid
  chargeType   String     @map("charge_type") @db.VarChar(20)
  amount       Decimal    @db.Decimal(18, 2)
  document     MemoReturn @relation(fields: [memoReturnId], references: [id], onDelete: Cascade)

  @@id([memoReturnId, chargeType])
  @@map("memo_return_charge")
  @@schema("partner")
}
