// api-master currently owns PostgreSQL schemas "partner" (ADR-0018, SA customer rev 1) and "stone"
// (stone master, ADR-0024; owner 2026-10-19).
// Migrations live in partner._prisma_migrations (D-01). Raw CHECK constraints are added in the
// migration SQL (database-diagram.md); Prisma does not diff CHECKs.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["partner", "stone"]
}

enum AddressType {
  INVOICE
  SHIPPING

  @@map("address_type")
  @@schema("partner")
}

model Customer {
  id           String            @id @default(uuid()) @db.Uuid
  name         String            @db.VarChar(200)
  nameKey      String            @map("name_key") @db.VarChar(200)
  /// ADR-0021: required; rows without a code were backfilled with the running number (C001 …).
  code         String            @db.VarChar(120)
  codeKey      String            @unique(map: "customer_code_key_key") @map("code_key") @db.VarChar(120)
  currencyCode String            @map("currency_code") @db.Char(3)
  active       Boolean           @default(true)
  firstName    String            @map("first_name") @db.VarChar(100)
  middleName   String?           @map("middle_name") @db.VarChar(100)
  lastName     String?           @map("last_name") @db.VarChar(100)
  phoneE164    String?           @map("phone_e164") @db.VarChar(16)
  phoneCountry String?           @map("phone_country") @db.Char(2)
  email        String            @db.VarChar(254)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamp(3)
  /// Optimistic version; written explicitly by the service (D-05), not @updatedAt.
  updatedAt    DateTime          @default(now()) @map("updated_at") @db.Timestamp(3)
  createdBy    String            @map("created_by") @db.VarChar(64)
  updatedBy    String            @map("updated_by") @db.VarChar(64)
  addresses    CustomerAddress[]
  quotations   Quotation[]
  memoOuts     MemoOut[]

  @@index([nameKey, id], map: "customer_name_key_id_idx")
  @@index([active, nameKey, id], map: "customer_active_name_key_id_idx")
  @@map("customer")
  @@schema("partner")
}

model CustomerAddress {
  id                 String      @id @default(uuid()) @db.Uuid
  customerId         String      @map("customer_id") @db.Uuid
  type               AddressType
  position           Int         @db.SmallInt
  name               String      @db.VarChar(200)
  taxId              String?     @map("tax_id") @db.VarChar(32)
  address            String      @db.VarChar(500)
  countryCode        String      @map("country_code") @db.Char(2)
  state              String      @db.VarChar(100)
  city               String      @db.VarChar(100)
  postcode           String      @db.VarChar(20)
  isDefault          Boolean     @default(false) @map("is_default")
  customer           Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shippingQuotations Quotation[] @relation("QuotationShippingAddress")
  invoiceQuotations  Quotation[] @relation("QuotationInvoiceAddress")
  shippingMemoOuts   MemoOut[]   @relation("MemoOutShippingAddress")
  invoiceMemoOuts    MemoOut[]   @relation("MemoOutInvoiceAddress")

  @@unique([customerId, type, position], map: "customer_address_position_key")
  @@unique([customerId, type], where: { isDefault: true }, map: "customer_address_one_default_key")
  @@map("customer_address")
  @@schema("partner")
}

// vendor SA revision 1 / ADR-0019: invoice addresses only (no `type` column), no relation to customer.
model Vendor {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(200)
  nameKey        String          @map("name_key") @db.VarChar(200)
  /// ADR-0021: required; rows without a code were backfilled with the running number (V001 …).
  code           String          @db.VarChar(120)
  codeKey        String          @unique(map: "vendor_code_key_key") @map("code_key") @db.VarChar(120)
  currencyCode   String          @map("currency_code") @db.Char(3)
  active         Boolean         @default(true)
  firstName      String          @map("first_name") @db.VarChar(100)
  middleName     String?         @map("middle_name") @db.VarChar(100)
  lastName       String?         @map("last_name") @db.VarChar(100)
  phoneE164      String?         @map("phone_e164") @db.VarChar(16)
  phoneCountry   String?         @map("phone_country") @db.Char(2)
  email          String          @db.VarChar(254)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamp(3)
  /// Optimistic version; written explicitly by the service (customer D-05), not @updatedAt.
  updatedAt      DateTime        @default(now()) @map("updated_at") @db.Timestamp(3)
  createdBy      String          @map("created_by") @db.VarChar(64)
  updatedBy      String          @map("updated_by") @db.VarChar(64)
  addresses      VendorAddress[]
  memoOutReturns MemoOutReturn[]
  memoReceives   MemoReceive[]
  memoReturns    MemoReturn[]

  @@index([nameKey, id], map: "vendor_name_key_id_idx")
  @@index([active, nameKey, id], map: "vendor_active_name_key_id_idx")
  @@map("vendor")
  @@schema("partner")
}

/// Invoice addresses only (ADR-0019 §3); no `type` column.
model VendorAddress {
  id             String          @id @default(uuid()) @db.Uuid
  vendorId       String          @map("vendor_id") @db.Uuid
  position       Int             @db.SmallInt
  name           String          @db.VarChar(200)
  taxId          String?         @map("tax_id") @db.VarChar(32)
  address        String          @db.VarChar(500)
  countryCode    String          @map("country_code") @db.Char(2)
  state          String          @db.VarChar(100)
  city           String          @db.VarChar(100)
  postcode       String          @db.VarChar(20)
  isDefault      Boolean         @default(false) @map("is_default")
  vendor         Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  memoOutReturns MemoOutReturn[]
  memoReceives   MemoReceive[]
  memoReturns    MemoReturn[]

  @@unique([vendorId, position], map: "vendor_address_position_key")
  /// Zero or one default per vendor (D-V03); a partial UNIQUE index allows zero rows.
  @@unique([vendorId], where: { isDefault: true }, map: "vendor_address_one_default_key")
  @@map("vendor_address")
  @@schema("partner")
}

/// Company Profile (company-profile SA revision 2, ADR-0021): exactly one row, id = 1 (CHECK in the
/// migration). The logo bytes are a file (`storage/company-profile/logo`); only metadata lives here.
model CompanyProfile {
  id                       Int       @id @default(1) @db.SmallInt
  name                     String    @db.VarChar(200)
  taxId                    String    @default("") @map("tax_id") @db.VarChar(50)
  contactName              String    @map("contact_name") @db.VarChar(200)
  phoneCountry             String    @map("phone_country") @db.Char(2)
  phoneE164                String    @map("phone_e164") @db.VarChar(16)
  email                    String    @db.VarChar(254)
  website                  String    @default("") @db.VarChar(300)
  address                  String    @db.VarChar(300)
  address2                 String    @default("") @db.VarChar(300)
  roadStreet               String    @default("") @map("road_street") @db.VarChar(300)
  countryCode              String    @map("country_code") @db.Char(2)
  state                    String    @db.VarChar(100)
  city                     String    @db.VarChar(100)
  postcode                 String    @db.VarChar(20)
  currencyCode             String    @map("currency_code") @db.Char(3)
  /// Plain text (SA-CP-13), "" = empty; rendered as text, never HTML.
  bankDetails              String    @default("") @map("bank_details")
  showBankDetailsOnInvoice Boolean   @default(false) @map("show_bank_details_on_invoice")
  logoContentType          String?   @map("logo_content_type") @db.VarChar(16)
  logoSizeBytes            Int?      @map("logo_size_bytes")
  logoSha256               String?   @map("logo_sha256") @db.Char(64)
  logoUpdatedAt            DateTime? @map("logo_updated_at") @db.Timestamp(3)
  logoStorageKey           String?   @map("logo_storage_key") @db.VarChar(512)
  /// Optimistic version (SA-CP-08): +1 on every save and logo change.
  version                  Int       @default(1)
  updatedBy                String    @map("updated_by") @db.VarChar(64)
  updatedAt                DateTime  @default(now()) @map("updated_at") @db.Timestamp(3)

  @@map("company_profile")
  @@schema("partner")
}

/// User-upload metadata tombstones are independent of CompanyProfile and cannot cascade away.
model StoredFile {
  id                  String               @id @db.Uuid
  kind                String               @db.VarChar(32)
  bucket              String               @db.VarChar(16)
  objectKey           String               @map("object_key") @db.VarChar(512)
  filename            String               @db.VarChar(255)
  contentType         String               @map("content_type") @db.VarChar(255)
  sizeBytes           BigInt               @map("size_bytes")
  sha256              String               @db.Char(64)
  status              String               @db.VarChar(16)
  sourceType          String               @map("source_type") @db.VarChar(64)
  sourceId            String               @map("source_id") @db.VarChar(128)
  createdBy           String?              @map("created_by") @db.VarChar(64)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  readyAt             DateTime?            @map("ready_at") @db.Timestamptz(6)
  expiresAt           DateTime?            @map("expires_at") @db.Timestamptz(6)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(6)
  purgeAfter          DateTime?            @map("purge_after") @db.Timestamptz(6)
  quotationLinePhotos QuotationLinePhoto[]

  @@unique([bucket, objectKey], map: "stored_files_bucket_object_key_key")
  @@index([sourceType, sourceId], map: "stored_files_source_idx")
  @@index([createdBy, createdAt(sort: Desc)], map: "stored_files_user_idx")
  @@map("stored_files")
  @@schema("partner")
}

// ---- Stone master (ADR-0024, SA stone-master rev 1; owner 2026-10-19: own PostgreSQL schema "stone") ----
// Simple lookup tables share one shape (SA-SM-03). Codes are stored UPPERCASE, so a plain unique
// index is case-insensitive (SA-SM-04). updatedAt is the optimistic version, written by the service.

enum StoneCodeMode {
  AUTO
  MANUAL

  @@map("stone_code_mode")
  @@schema("stone")
}

model StoneGroup {
  id         String      @id @default(uuid()) @db.Uuid
  code       String      @unique(map: "stone_group_code_key") @db.VarChar(20)
  name       String      @db.VarChar(120)
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt  DateTime    @default(now()) @map("updated_at") @db.Timestamp(3)
  createdBy  String      @map("created_by") @db.VarChar(64)
  updatedBy  String      @map("updated_by") @db.VarChar(64)
  stoneNames StoneName[]

  @@map("stone_group")
  @@schema("stone")
}

/// Owner 2026-10-23: a size has only a Name (unique); Auto stone codes use it for the size part.
model StoneSize {
  id         String           @id @default(uuid()) @db.Uuid
  name       String           @unique(map: "stone_size_name_key") @db.VarChar(120)
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt  DateTime         @default(now()) @map("updated_at") @db.Timestamp(3)
  createdBy  String           @map("created_by") @db.VarChar(64)
  updatedBy  String           @map("updated_by") @db.VarChar(64)
  shapes     StoneShapeSize[]
  stoneCodes StoneCode[]

  @@map("stone_size")
  @@schema("stone")
}

model StoneColor {
  id         String      @id @default(uuid()) @db.Uuid
  code       String      @unique(map: "stone_color_code_key") @db.VarChar(20)
  name       String      @db.VarChar(120)
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt  DateTime    @default(now()) @map("updated_at") @db.Timestamp(3)
  createdBy  String      @map("created_by") @db.VarChar(64)
  updatedBy  String      @map("updated_by") @db.VarChar(64)
  stoneCodes StoneCode[]

  @@map("stone_color")
  @@schema("stone")
}

model StoneCutting {
  id         String      @id @default(uuid()) @db.Uuid
  code       String      @unique(map: "stone_cutting_code_key") @db.VarChar(20)
  name       String      @db.VarChar(120)
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt  DateTime    @default(now()) @map("updated_at") @db.Timestamp(3)
  createdBy  String      @map("created_by") @db.VarChar(64)
  updatedBy  String      @map("updated_by") @db.VarChar(64)
  stoneCodes StoneCode[]

  @@map("stone_cutting")
  @@schema("stone")
}

model StoneClarity {
  id         String      @id @default(uuid()) @db.Uuid
  code       String      @unique(map: "stone_clarity_code_key") @db.VarChar(20)
  name       String      @db.VarChar(120)
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt  DateTime    @default(now()) @map("updated_at") @db.Timestamp(3)
  createdBy  String      @map("created_by") @db.VarChar(64)
  updatedBy  String      @map("updated_by") @db.VarChar(64)
  stoneCodes StoneCode[]

  @@map("stone_clarity")
  @@schema("stone")
}

model StoneQuality {
  id         String      @id @default(uuid()) @db.Uuid
  code       String      @unique(map: "stone_quality_code_key") @db.VarChar(20)
  name       String      @db.VarChar(120)
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt  DateTime    @default(now()) @map("updated_at") @db.Timestamp(3)
  createdBy  String      @map("created_by") @db.VarChar(64)
  updatedBy  String      @map("updated_by") @db.VarChar(64)
  stoneCodes StoneCode[]

  @@map("stone_quality")
  @@schema("stone")
}

model StoneName {
  id         String      @id @default(uuid()) @db.Uuid
  code       String      @unique(map: "stone_name_code_key") @db.VarChar(20)
  name       String      @db.VarChar(120)
  groupId    String      @map("group_id") @db.Uuid
  hsn        String?     @db.VarChar(8)
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt  DateTime    @default(now()) @map("updated_at") @db.Timestamp(3)
  createdBy  String      @map("created_by") @db.VarChar(64)
  updatedBy  String      @map("updated_by") @db.VarChar(64)
  group      StoneGroup  @relation(fields: [groupId], references: [id], onDelete: Restrict)
  stoneCodes StoneCode[]

  @@index([groupId], map: "stone_name_group_id_idx")
  @@map("stone_name")
  @@schema("stone")
}

model StoneShape {
  id         String           @id @default(uuid()) @db.Uuid
  code       String           @unique(map: "stone_shape_code_key") @db.VarChar(20)
  name       String           @db.VarChar(120)
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt  DateTime         @default(now()) @map("updated_at") @db.Timestamp(3)
  createdBy  String           @map("created_by") @db.VarChar(64)
  updatedBy  String           @map("updated_by") @db.VarChar(64)
  sizes      StoneShapeSize[]
  stoneCodes StoneCode[]

  @@map("stone_shape")
  @@schema("stone")
}

model StoneShapeSize {
  shapeId String     @map("shape_id") @db.Uuid
  sizeId  String     @map("size_id") @db.Uuid
  shape   StoneShape @relation(fields: [shapeId], references: [id], onDelete: Cascade)
  size    StoneSize  @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  @@id([shapeId, sizeId])
  @@index([sizeId], map: "stone_shape_size_size_id_idx")
  @@map("stone_shape_size")
  @@schema("stone")
}

model StoneCode {
  id                 String              @id @default(uuid()) @db.Uuid
  code               String              @unique(map: "stone_code_code_key") @db.VarChar(60)
  mode               StoneCodeMode
  /// Owner 2026-10-20: only the parts at positions #1 and #2 are required, so every part is nullable.
  stoneNameId        String?             @map("stone_name_id") @db.Uuid
  sizeId             String?             @map("size_id") @db.Uuid
  shapeId            String?             @map("shape_id") @db.Uuid
  colorId            String?             @map("color_id") @db.Uuid
  cuttingId          String?             @map("cutting_id") @db.Uuid
  clarityId          String?             @map("clarity_id") @db.Uuid
  qualityId          String?             @map("quality_id") @db.Uuid
  /// Permutation of name,size,shape,color,cutting,clarity,quality (CHECK in the migration).
  partOrder          String[]            @map("part_order")
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt          DateTime            @default(now()) @map("updated_at") @db.Timestamp(3)
  createdBy          String              @map("created_by") @db.VarChar(64)
  updatedBy          String              @map("updated_by") @db.VarChar(64)
  stoneName          StoneName?          @relation(fields: [stoneNameId], references: [id], onDelete: Restrict)
  size               StoneSize?          @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  shape              StoneShape?         @relation(fields: [shapeId], references: [id], onDelete: Restrict)
  color              StoneColor?         @relation(fields: [colorId], references: [id], onDelete: Restrict)
  cutting            StoneCutting?       @relation(fields: [cuttingId], references: [id], onDelete: Restrict)
  clarity            StoneClarity?       @relation(fields: [clarityId], references: [id], onDelete: Restrict)
  quality            StoneQuality?       @relation(fields: [qualityId], references: [id], onDelete: Restrict)
  quotationLines     QuotationLine[]
  memoOutLines       MemoOutLine[]
  memoOutReturnLines MemoOutReturnLine[]
  memoReceiveLines   MemoReceiveLine[]
  memoReturnLines    MemoReturnLine[]

  @@index([stoneNameId], map: "stone_code_stone_name_id_idx")
  @@index([sizeId], map: "stone_code_size_id_idx")
  @@index([shapeId], map: "stone_code_shape_id_idx")
  @@index([colorId], map: "stone_code_color_id_idx")
  @@index([cuttingId], map: "stone_code_cutting_id_idx")
  @@index([clarityId], map: "stone_code_clarity_id_idx")
  @@index([qualityId], map: "stone_code_quality_id_idx")
  @@map("stone_code")
  @@schema("stone")
}

/// Document Setup (document-setup SA revision 1, owner 2026-10-23): one row per transaction type from the
/// fixed list in `src/document-setup/document-setup.transactions.ts`. Name is the printed document header.
model DocumentSetup {
  transactionKey String              @id @map("transaction_key") @db.VarChar(40)
  name           String              @db.VarChar(120)
  /// Stored UPPERCASE; unique across transactions (Q-DS-10).
  code           String              @unique @db.VarChar(10)
  /// Default Start No for new numbering rows (Q-DS-03).
  startFrom      Int                 @map("start_from")
  /// Plain text printed on the document, "" = empty (Q-DS-09).
  declaration    String              @default("") @db.VarChar(2000)
  /// Optimistic version: +1 on every save.
  version        Int                 @default(1)
  updatedBy      String              @map("updated_by") @db.VarChar(64)
  updatedAt      DateTime            @default(now()) @map("updated_at") @db.Timestamp(3)
  rows           DocumentNumbering[]

  @@map("document_setup")
  @@schema("partner")
}

/// A numbering period: applies from `effectiveDate` until the next row's date (owner 2026-10-23).
/// Document number = prefix + separator + running number, no zero padding (Q-DS-04, Q-DS-05).
model DocumentNumbering {
  id             String          @id @db.Uuid
  transactionKey String          @map("transaction_key") @db.VarChar(40)
  effectiveDate  DateTime        @map("effective_date") @db.Date
  prefix         String          @default("") @db.VarChar(10)
  separator      String          @default("") @db.VarChar(3)
  startNo        Int             @map("start_no")
  setup          DocumentSetup   @relation(fields: [transactionKey], references: [transactionKey], onDelete: Cascade)
  /// Owner 2026-10-26 (SA-QT-04/05): a row referenced by a quotation is "used" and locked.
  quotations     Quotation[]
  memoOuts       MemoOut[]
  memoOutReturns MemoOutReturn[]
  memoReceives   MemoReceive[]
  memoReturns    MemoReturn[]

  @@unique([transactionKey, effectiveDate])
  @@map("document_numbering")
  @@schema("partner")
}

// ---- Quotation (SA quotation rev 1, ADR-0032; approved 2026-10-26) ----
// Ids + text snapshots (SA-QT-06/07); totals are server-computed (SA-QT-08); `version` is the
// optimistic version (SA-QT-09). Status/discount/tax/labor/source/price-unit values are CHECKed in SQL.

model Quotation {
  id                      String             @id @db.Uuid
  /// null = plain running number 1, 2, 3 … (no Document Setup row in effect, owner 2026-10-26).
  numberingId             String?            @map("numbering_id") @db.Uuid
  runningNo               Int                @map("running_no")
  docNo                   String             @unique(map: "quotation_doc_no_key") @map("doc_no") @db.VarChar(40)
  status                  String             @db.VarChar(20)
  docDate                 DateTime           @map("doc_date") @db.Date
  dueDate                 DateTime           @map("due_date") @db.Date
  customerId              String             @map("customer_id") @db.Uuid
  customerCodeSnapshot    String             @map("customer_code_snapshot") @db.VarChar(120)
  customerNameSnapshot    String             @map("customer_name_snapshot") @db.VarChar(200)
  shippingAddressId       String?            @map("shipping_address_id") @db.Uuid
  shippingAddressSnapshot String             @map("shipping_address_snapshot") @db.VarChar(1000)
  invoiceAddressId        String?            @map("invoice_address_id") @db.Uuid
  invoiceAddressSnapshot  String             @map("invoice_address_snapshot") @db.VarChar(1000)
  currencyCode            String             @map("currency_code") @db.Char(3)
  exchangeRate            Decimal?           @map("exchange_rate") @db.Decimal(18, 6)
  ref                     String             @default("") @db.VarChar(100)
  documentNote            String             @default("") @map("document_note") @db.VarChar(500)
  discountType            String             @map("discount_type") @db.VarChar(10)
  discountValue           Decimal            @map("discount_value") @db.Decimal(18, 4)
  taxEnabled              Boolean            @map("tax_enabled")
  taxRate                 Decimal            @map("tax_rate") @db.Decimal(9, 4)
  taxIncluded             Boolean            @map("tax_included")
  laborWork               String?            @map("labor_work") @db.VarChar(120)
  laborBasis              String?            @map("labor_basis") @db.VarChar(10)
  laborQty                Decimal?           @map("labor_qty") @db.Decimal(18, 3)
  laborRate               Decimal?           @map("labor_rate") @db.Decimal(18, 2)
  subtotal                Decimal            @db.Decimal(18, 2)
  discountAmount          Decimal            @map("discount_amount") @db.Decimal(18, 2)
  priceBeforeTax          Decimal            @map("price_before_tax") @db.Decimal(18, 2)
  taxAmount               Decimal            @map("tax_amount") @db.Decimal(18, 2)
  chargesAmount           Decimal            @map("charges_amount") @db.Decimal(18, 2)
  laborAmount             Decimal            @map("labor_amount") @db.Decimal(18, 2)
  grandTotal              Decimal            @map("grand_total") @db.Decimal(18, 2)
  statusReason            String?            @map("status_reason") @db.VarChar(500)
  version                 Int                @default(1)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamp(3)
  createdBy               String             @map("created_by") @db.VarChar(64)
  updatedAt               DateTime           @default(now()) @map("updated_at") @db.Timestamp(3)
  updatedBy               String             @map("updated_by") @db.VarChar(64)
  approvedAt              DateTime?          @map("approved_at") @db.Timestamp(3)
  approvedBy              String?            @map("approved_by") @db.VarChar(64)
  numbering               DocumentNumbering? @relation(fields: [numberingId], references: [id], onDelete: Restrict)
  customer                Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shippingAddress         CustomerAddress?   @relation("QuotationShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  invoiceAddress          CustomerAddress?   @relation("QuotationInvoiceAddress", fields: [invoiceAddressId], references: [id], onDelete: SetNull)
