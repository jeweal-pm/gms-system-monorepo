NODE_ENV=development

# PostgreSQL is started with `pnpm infra:up`.
DATABASE_URL=postgresql://f1_user:f1_dev_password@127.0.0.1:5432/f1_system

# Generate a unique random value for deployments. Local Compose uses this value.
CRM_API_KEY=local-development-crm-key-change-before-deploy
AUTH_SECRET=local-development-secret-change-this-to-at-least-32-characters
LICENSE_MODE=mock
LICENSE_API_URL=
LICENSE_INSTANCE_ID=local-dev
LICENSE_INSTANCE_API_KEY=local-dev-only
LICENSE_JWT_ISSUER=f1-system-license-dev
LICENSE_JWT_AUDIENCE=f1-system-customer-backend
# Generate an Ed25519 keypair for local mock signing; keep the private key out of git.
# Set LICENSE_PUBLIC_KEYS_JSON to a JSON object mapping LICENSE_MOCK_KID to the public-key DER base64.
LICENSE_PUBLIC_KEYS_JSON=
LICENSE_MOCK_KID=
LICENSE_MOCK_PRIVATE_KEY_PKCS8_BASE64=
AUTH_SERVICE_URL=http://localhost:3101
AUTH_SERVICE_INTERNAL_URL=http://backend-api-auth:3101
GATEWAY_URL=http://localhost:4000
GATEWAY_INTERNAL_URL=http://backend-api-gateway:4000
FRONTEND_URL=http://localhost:3000

# backend-api-partner (ADR-0018). Host-run dev uses 127.0.0.1; Compose uses the CONTAINER URL.
# Dev reuses the existing local role; production uses the restricted f1_partner role.
PARTNER_DATABASE_URL=postgresql://f1_user:f1_dev_password@127.0.0.1:5432/f1_system?schema=partner
PARTNER_CONTAINER_DATABASE_URL=postgresql://f1_user:f1_dev_password@postgres:5432/f1_system?schema=partner
PARTNER_SERVICE_URL=http://localhost:3201
PARTNER_SERVICE_INTERNAL_URL=http://backend-api-partner:3201
# Required by Compose (fails fast if unset). Generate a unique random value (>= 32 chars) for
# every deployment; gateway and partner share it. Production refuses this example value.
PARTNER_SERVICE_TOKEN=local-development-partner-token-change-before-deploy-0000
