// backend-api-inventory owns PostgreSQL schema "inventory" (ADR-0052 D1, load-to-stock SA rev 1 database-diagram.md part A).
// The models mirror migration 20261117100000_inventory_init exactly (introspected, table/column names as in SQL);
// CHECK constraints live in the migration SQL. History: inventory._prisma_migrations. Migrations run only in the
// one-off migrate job (gms_inventory_migrator).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["inventory"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model approval_setting {
  type             String   @id @db.VarChar(32)
  require_approval Boolean
  version          Int      @default(1)
  updated_at       DateTime @default(now()) @db.Timestamptz(3)
  updated_by       String?  @db.VarChar(64)
  updated_by_name  String?  @db.VarChar(200)

  @@schema("inventory")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model load_to_stock {
  id                   String                 @id @db.Uuid
  numbering_id         String?                @db.Uuid
  running_no           Int                    @unique(map: "load_to_stock_plain_running_no_key", where: raw("(numbering_id IS NULL)"))
  doc_no               String                 @unique @db.VarChar(40)
  status               String                 @db.VarChar(20)
  provisional          Boolean                @default(false)
  sync_state           String                 @default("IDLE") @db.VarChar(10)
  applied_revision     Int                    @default(0)
  doc_date             DateTime               @db.Date
  vendor_id            String                 @db.Uuid
  vendor_code_snapshot String                 @default("") @db.VarChar(120)
  vendor_name_snapshot String                 @default("") @db.VarChar(200)
  currency_code        String                 @db.Char(3)
  ref                  String                 @default("") @db.VarChar(100)
  document_note        String                 @default("") @db.VarChar(250)
  mode                 String                 @db.VarChar(10)
  row_count            Int                    @db.SmallInt
  total_pcs            Int
  total_weight_ct      Decimal                @db.Decimal(15, 3)
  total_cost_base      Decimal                @db.Decimal(18, 2)
  auto_approved        Boolean                @default(false)
  revision_count       Int                    @default(0) @db.SmallInt
  submitted_at         DateTime?              @db.Timestamptz(3)
  submitted_by         String?                @db.VarChar(64)
  submitted_by_name    String?                @db.VarChar(200)
  review_action        String?                @db.VarChar(10)
  review_note          String?                @db.VarChar(500)
  reviewed_at          DateTime?              @db.Timestamptz(3)
  reviewed_by          String?                @db.VarChar(64)
  reviewed_by_name     String?                @db.VarChar(200)
  approved_at          DateTime?              @db.Timestamptz(3)
  approved_by          String?                @db.VarChar(64)
  deleted_at           DateTime?              @db.Timestamptz(3)
  deleted_by           String?                @db.VarChar(64)
  version              Int                    @default(1)
  created_at           DateTime               @default(now()) @db.Timestamptz(3)
  created_by           String                 @db.VarChar(64)
  updated_at           DateTime               @default(now()) @db.Timestamptz(3)
  updated_by           String                 @db.VarChar(64)
  load_to_stock_row    load_to_stock_row[]
  load_to_stock_source load_to_stock_source[]
  master_sync_op       master_sync_op[]

  @@unique([numbering_id, running_no], map: "load_to_stock_numbering_running_no_key")
  @@index([doc_date(sort: Desc), created_at(sort: Desc), id(sort: Desc)], map: "load_to_stock_deleted_list_idx", where: raw("(deleted_at IS NOT NULL)"))
  @@index([doc_date(sort: Desc), created_at(sort: Desc), id(sort: Desc)], map: "load_to_stock_list_idx", where: raw("((deleted_at IS NULL) AND (NOT provisional))"))
  @@index([submitted_at, id], map: "load_to_stock_pending_idx", where: raw("(((status)::text = 'PENDING_APPROVAL'::text) AND (deleted_at IS NULL))"))
  @@index([id], map: "load_to_stock_revision_idx", where: raw("(((status)::text = 'REVISION_REQUESTED'::text) AND (deleted_at IS NULL))"))
  @@index([sync_state], map: "load_to_stock_syncing_idx", where: raw("((sync_state)::text = 'SYNCING'::text)"))
  @@index([vendor_id, doc_date(sort: Desc)], map: "load_to_stock_vendor_idx")
  @@schema("inventory")
}

