  labor_qty                 Decimal?       @db.Decimal(18, 3)
  labor_rate                Decimal?       @db.Decimal(18, 2)
  subtotal                  Decimal        @db.Decimal(18, 2)
  discount_amount           Decimal        @db.Decimal(18, 2)
  price_before_tax          Decimal        @db.Decimal(18, 2)
  tax_amount                Decimal        @db.Decimal(18, 2)
  charges_amount            Decimal        @db.Decimal(18, 2)
  labor_amount              Decimal        @db.Decimal(18, 2)
  grand_total               Decimal        @db.Decimal(18, 2)
  line_count                Int            @db.SmallInt
  total_pcs                 Int
  total_weight_ct           Decimal        @db.Decimal(15, 3)
  auto_approved             Boolean        @default(false)
  revision_count            Int            @default(0) @db.SmallInt
  submitted_at              DateTime?      @db.Timestamptz(3)
  submitted_by              String?        @db.VarChar(64)
  submitted_by_name         String?        @db.VarChar(200)
  review_action             String?        @db.VarChar(10)
  review_note               String?        @db.VarChar(500)
  reviewed_at               DateTime?      @db.Timestamptz(3)
  reviewed_by               String?        @db.VarChar(64)
  reviewed_by_name          String?        @db.VarChar(200)
  approved_at               DateTime?      @db.Timestamptz(3)
  approved_by               String?        @db.VarChar(64)
  deleted_at                DateTime?      @db.Timestamptz(3)
  deleted_by                String?        @db.VarChar(64)
  version                   Int            @default(1)
  created_at                DateTime       @default(now()) @db.Timestamptz(3)
  created_by                String         @db.VarChar(64)
  updated_at                DateTime       @default(now()) @db.Timestamptz(3)
  updated_by                String         @db.VarChar(64)
  sale_charge               sale_charge[]
  sale_line                 sale_line[]
  sale_sync_op              sale_sync_op[]

  @@unique([numbering_id, running_no], map: "sale_numbering_running_no_key")
  @@index([customer_id, doc_date(sort: Desc)], map: "sale_customer_idx")
  @@index([doc_date(sort: Desc), created_at(sort: Desc), id(sort: Desc)], map: "sale_deleted_list_idx", where: raw("(deleted_at IS NOT NULL)"))
  @@index([doc_date(sort: Desc), created_at(sort: Desc), id(sort: Desc)], map: "sale_list_idx", where: raw("((deleted_at IS NULL) AND (NOT provisional))"))
  @@index([submitted_at, id], map: "sale_pending_idx", where: raw("(((status)::text = 'PENDING_APPROVAL'::text) AND (deleted_at IS NULL))"))
  @@index([id], map: "sale_revision_idx", where: raw("(((status)::text = 'REVISION_REQUESTED'::text) AND (deleted_at IS NULL))"))
  @@index([sync_state], map: "sale_syncing_idx", where: raw("((sync_state)::text = 'SYNCING'::text)"))
  @@schema("inventory")
}

