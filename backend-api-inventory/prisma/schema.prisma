/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model master_sync_op {
  id              String        @id @db.Uuid
  load_id         String        @db.Uuid
  revision        Int
  kind            String        @db.VarChar(16)
  state           String        @db.VarChar(10)
  request_hash    String        @db.Char(64)
  payload         Json
  result          Json?
  attempts        Int           @default(0) @db.SmallInt
  next_attempt_at DateTime      @db.Timestamptz(3)
  last_error      String?       @db.VarChar(64)
  created_by      String        @db.VarChar(64)
  created_at      DateTime      @default(now()) @db.Timestamptz(3)
  updated_at      DateTime      @default(now()) @db.Timestamptz(3)
  load_to_stock   load_to_stock @relation(fields: [load_id], references: [id], onDelete: Cascade, map: "master_sync_op_load_fkey")

  @@unique([load_id, revision], map: "master_sync_op_load_revision_key")
  @@index([updated_at], map: "master_sync_op_done_idx", where: raw("((state)::text = 'DONE'::text)"))
  @@index([next_attempt_at], map: "master_sync_op_due_idx", where: raw("((state)::text = ANY ((ARRAY['PREPARED'::character varying, 'CONFIRMED'::character varying])::text[]))"))
  @@schema("inventory")
}

