/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model stock {
  id                   String             @id @db.Uuid
  stock_id             String             @unique @db.VarChar(10)
  load_row_id          String?            @unique @db.Uuid
  load_id              String             @db.Uuid
  status               String             @default("ACTIVE") @db.VarChar(10)
  location             String             @db.VarChar(40)
  parcel               String             @default("") @db.VarChar(50)
  stone_code_id        String?            @db.Uuid
  stone_code           String             @default("") @db.VarChar(60)
  stone                String             @default("") @db.VarChar(60)
  shape                String             @default("") @db.VarChar(60)
  size                 String             @default("") @db.VarChar(60)
  color                String             @default("") @db.VarChar(60)
  clarity              String             @default("") @db.VarChar(60)
  cutting              String             @default("") @db.VarChar(60)
  quality              String             @default("") @db.VarChar(60)
  lot                  String             @default("") @db.VarChar(40)
  cer_type             String             @default("") @db.VarChar(20)
  cer_no               String             @default("") @db.VarChar(60)
  price_unit           String             @db.VarChar(10)
  pcs                  Int
  weight_ct            Decimal            @db.Decimal(12, 3)
  on_hand_pcs          Int
  on_hand_weight_ct    Decimal            @db.Decimal(12, 3)
  reserved_pcs         Int                @default(0)
  reserved_weight_ct   Decimal            @default(0) @db.Decimal(12, 3)
  memo_out_pcs         Int                @default(0)
  memo_out_weight_ct   Decimal            @default(0) @db.Decimal(12, 3)
  sold_pcs             Int                @default(0)
  sold_weight_ct       Decimal            @default(0) @db.Decimal(12, 3)
  consumed_pcs         Int                @default(0)
  consumed_weight_ct   Decimal            @default(0) @db.Decimal(12, 3)
  unit_cost_base       Decimal            @db.Decimal(18, 4)
  cost_amount_base     Decimal            @db.Decimal(18, 2)
  stock_price          Decimal            @db.Decimal(18, 2)
  sale_price           Decimal            @db.Decimal(18, 2)
  currency_code        String             @db.Char(3)
  vendor_id            String             @db.Uuid
  vendor_name_snapshot String             @default("") @db.VarChar(200)
  item_note            String             @default("") @db.VarChar(500)
  first_used_at        DateTime?          @db.Timestamptz(3)
  /// ADR-0052 D16: the load's doc date / number (picker key of the one From Stock list).
  ref_doc_date         DateTime           @db.Date
  ref_doc_no           String             @db.VarChar(40)
  /// lot-based-stock ADR-0055 D2: STORED GENERATED group key; owner change 2026-11-21 (Q4): OS+id for every stock (own stock
  /// is not merged this round). Written by PostgreSQL only.
  lot_key              String?            @db.VarChar(40)
  /// stock-card ADR-0056 D3: STORED GENERATED identity of a Stock Card (stone code or attributes, location, lot; trimmed, case-insensitive). Written by PostgreSQL only.
  card_key             String?            @db.VarChar(34)
  /// stock-value ADR-0057 D4: STORED GENERATED stone identity (the item part of card_key, no location or lot). Written by PostgreSQL only.
  item_key             String?            @db.VarChar(34)
  version             Int                @default(1)
  created_at           DateTime           @default(now()) @db.Timestamptz(3)
  updated_at           DateTime           @default(now()) @db.Timestamptz(3)
  load_to_stock_row    load_to_stock_row? @relation(fields: [load_row_id], references: [id], onDelete: Restrict, map: "stock_load_row_fkey")
  stock_hold           stock_hold[]
  stock_movement       stock_movement[]
  stock_photo          stock_photo[]

  @@index([ref_doc_date(sort: Desc), stock_id(sort: Desc)], map: "stock_picker_idx", where: raw("(((status)::text = 'ACTIVE'::text) AND ((on_hand_pcs > 0) OR (on_hand_weight_ct > (0)::numeric)))"))
  @@index([load_id], map: "stock_in_use_idx", where: raw("((on_hand_pcs <> pcs) OR (on_hand_weight_ct <> weight_ct))"))
  @@index([load_id], map: "stock_load_idx")
  @@index([card_key], map: "stock_card_key_idx")
  @@index([lot_key, ref_doc_date, stock_id], map: "stock_lot_open_idx", where: raw("(((status)::text = 'ACTIVE'::text) AND ((on_hand_pcs > 0) OR (on_hand_weight_ct > (0)::numeric)))"))
  @@schema("inventory")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model stock_hold {
  id                  String              @id @db.Uuid
  document_type       String              @db.VarChar(40)
  document_id         String              @db.Uuid
  stock_uuid          String              @db.Uuid
  kind                String              @db.VarChar(20)
  pcs                 Int
  weight_ct           Decimal             @db.Decimal(12, 3)
  revision            Int
  document_no         String?             @db.VarChar(40)
  created_at          DateTime            @default(now()) @db.Timestamptz(3)
  updated_at          DateTime            @default(now()) @db.Timestamptz(3)
  stock               stock               @relation(fields: [stock_uuid], references: [id], map: "stock_hold_stock_fkey")
  stock_hold_document stock_hold_document @relation(fields: [document_type, document_id], references: [document_type, document_id], onDelete: Cascade, map: "stock_hold_document_fkey")

  @@unique([document_type, document_id, stock_uuid], map: "stock_hold_doc_stock_key")
  @@index([document_type, document_id], map: "stock_hold_document_idx")
  @@index([stock_uuid], map: "stock_hold_stock_idx")
  @@schema("inventory")
}

/// ADR-0052 D18: one row per holding document — the applied revision, its request hash and a small result.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model stock_hold_document {
  document_type    String       @db.VarChar(40)
  document_id      String       @db.Uuid
  applied_revision Int
  request_hash     String       @db.Char(64)
  document_no      String?      @db.VarChar(40)
  result           Json         @default("{}")
  updated_at       DateTime     @default(now()) @db.Timestamptz(3)
  /// stock-card ADR-0056 D7: document date and account (customer) snapshot sent by api-master; NULL / '' until filled.
  doc_date         DateTime?    @db.Date
  party_id         String?      @db.Uuid
  party_name       String       @default("") @db.VarChar(200)
  stock_hold       stock_hold[]

  @@id([document_type, document_id])
  @@schema("inventory")
}

